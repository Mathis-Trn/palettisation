# Variables lues directement par le backend (indépendamment de docker-compose.yml, qui les
# transmet déjà pour le déploiement conteneurisé — voir le .env.example racine).

# "production" ou "development". En production, ALLOWED_ORIGINS ne peut jamais valoir "*"
# (l'application refuse de démarrer).
APP_ENV=development

# CORS : liste d'origines séparées par des virgules.
ALLOWED_ORIGINS=http://localhost:3000

# --- Jobs de palettisation asynchrones (voir README.md, section "Jobs asynchrones") ---------

# Délai (secondes) au-delà duquel un job encore "running" est marqué "expired". Les commandes les
# plus volumineuses peuvent nécessiter proche d'1h pour un rangement dense (peu de palettes).
PALLETIZATION_JOB_TIMEOUT_SECONDS=3600

# Durée (secondes) de rétention du résultat d'un job terminé avant purge mémoire.
PALLETIZATION_JOB_RETENTION_SECONDS=3600

# Nombre de calculs exécutés en parallèle par cette instance (ProcessPoolExecutor).
PALLETIZATION_MAX_CONCURRENT_JOBS=1

# Nombre de processus workers utilisés pour paralléliser le calcul d'UN SEUL job volumineux
# au-delà de PARALLEL_BATCH_THRESHOLD instances (voir README.md, section "Performance sur les
# grandes commandes"). Par défaut : nombre de coeurs CPU détectés (os.cpu_count()).
# PALLETIZATION_PACKING_WORKERS=4

# Réservé aux tests automatisés (unit/e2e) : active l'en-tête `X-Palletizer-Test-Delay-Seconds`
# qui fait dormir le worker avant de lancer le calcul réel, pour simuler un calcul long sans
# attendre plusieurs minutes. Ne JAMAIS activer en développement normal ni en production.
# PALLETIZER_ENABLE_TEST_HOOKS=1
