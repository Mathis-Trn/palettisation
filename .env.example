# Variables lues par docker-compose.yml (racine du dépôt).

# CORS backend : liste d'origines séparées par des virgules. Jamais "*" en production.
ALLOWED_ORIGINS=http://localhost:3000

# URL du backend telle que joignable depuis le NAVIGATEUR de l'utilisateur final (pas depuis le
# réseau interne docker-compose : ne jamais utiliser "http://backend:8000" ici).
NEXT_PUBLIC_PALLETIZER_API_URL=http://localhost:8000
