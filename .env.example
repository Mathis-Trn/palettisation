# Variables lues par docker-compose.yml (racine du dépôt).

# CORS backend : liste d'origines séparées par des virgules. Jamais "*" en production.
ALLOWED_ORIGINS=http://localhost:3000

# URL du backend telle que joignable depuis le NAVIGATEUR de l'utilisateur final (pas depuis le
# réseau interne docker-compose : ne jamais utiliser "http://backend:8000" ici).
NEXT_PUBLIC_PALLETIZER_API_URL=http://localhost:8000

# --- Jobs de palettisation asynchrones ------------------------------------------------------
# Le calcul (potentiellement long) tourne en tâche de fond côté backend (ProcessPoolExecutor),
# jamais dans une requête HTTP maintenue ouverte — voir backend/README.md.

# Délai (secondes) au-delà duquel un job encore "running" est marqué "expired" et abandonné. Les
# commandes les plus volumineuses (dizaines de milliers de cartons) peuvent nécessiter proche d'1h
# pour un rangement dense (peu de palettes) ; le job continue de toute façon en tâche de fond sans
# jamais bloquer l'utilisateur, quelle que soit la durée réelle du calcul.
PALLETIZATION_JOB_TIMEOUT_SECONDS=3600

# Durée (secondes) pendant laquelle le résultat d'un job terminé reste consultable via
# GET /api/v1/palletization-jobs/{id} avant d'être purgé de la mémoire du backend.
PALLETIZATION_JOB_RETENTION_SECONDS=3600

# Nombre de calculs de palettisation exécutés en parallèle par cette instance de backend. Un job
# supplémentaire reste "queued" jusqu'à ce qu'un emplacement se libère.
PALLETIZATION_MAX_CONCURRENT_JOBS=1

# Nombre de processus workers utilisés pour PARALLÉLISER le calcul d'UN SEUL job volumineux
# (au-delà de PARALLEL_BATCH_THRESHOLD instances, voir backend/README.md). Par défaut : nombre de
# coeurs CPU détectés. Sans effet sur les commandes plus petites (toujours traitées séquentiellement,
# sans compromis de compacité).
# PALLETIZATION_PACKING_WORKERS=4

# Intervalle (millisecondes) auquel le frontend interroge GET /api/v1/palletization-jobs/{id}
# pendant qu'un calcul est en cours.
NEXT_PUBLIC_JOB_POLL_INTERVAL_MS=2000

# Timeout (millisecondes) des requêtes HTTP courtes du frontend (création/consultation de job,
# santé, capacités) — jamais utilisé pour le calcul lui-même, qui est asynchrone.
NEXT_PUBLIC_API_REQUEST_TIMEOUT_MS=15000
